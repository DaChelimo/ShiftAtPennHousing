---
/*
 * SKETCH.md §3: left sidebar, three collapsible groups matching the three
 * sections, current page marked. Each group header is the section overview page
 * and is itself clickable. No third-level nesting except under /system/floating.
 */
import { withBase } from '../href'
import { sections, topLevel } from '../nav'
import Search from './Search.astro'
import ThemeToggle from './ThemeToggle.astro'

type Props = { current: string }
const { current } = Astro.props
---

<div class="sidebar" id="sidebar" data-drawer>
  <div class="sidebar__inner">
    <div class="sidebar__top">
      <a class="sidebar__brand" href={withBase('/')}>
        <span class="sidebar__brand-mark">Shift</span>
        <span class="sidebar__brand-sub">User guide</span>
      </a>
      <ThemeToggle />
    </div>

    <Search />

    <nav class="sidebar__nav" aria-label="Guide">
      <ul class="sidebar__list">
        {
          topLevel.map((entry) => (
            <li>
              <a
                class:list={['sidebar__link', current === entry.slug && 'is-current']}
                href={withBase(`/${entry.slug}`)}
                aria-current={current === entry.slug ? 'page' : undefined}
              >
                {entry.label}
              </a>
            </li>
          ))
        }
      </ul>

      {
        sections.map((section) => {
          const inSection = current === section.slug || current.startsWith(`${section.slug}/`)
          return (
            <details class="sidebar__group" open={inSection}>
              <summary class="sidebar__summary">
                <span class="eyebrow">{section.label}</span>
                <svg class="sidebar__chevron" viewBox="0 0 10 10" width="9" height="9" aria-hidden="true">
                  <path d="M3 1.5 6.5 5 3 8.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                </svg>
              </summary>
              <ul class="sidebar__list">
                <li>
                  <a
                    class:list={['sidebar__link', 'sidebar__link--overview', current === section.slug && 'is-current']}
                    href={withBase(`/${section.slug}`)}
                    aria-current={current === section.slug ? 'page' : undefined}
                  >
                    Overview
                  </a>
                </li>
                {section.entries.map((entry) => (
                  <li>
                    <a
                      class:list={[
                        'sidebar__link',
                        entry.slug.split('/').length > 2 && 'sidebar__link--nested',
                        current === entry.slug && 'is-current',
                      ]}
                      href={withBase(`/${entry.slug}`)}
                      aria-current={current === entry.slug ? 'page' : undefined}
                    >
                      {entry.label}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          )
        })
      }
    </nav>
  </div>
</div>

<style>
  .sidebar {
    position: sticky;
    top: 0;
    height: 100vh;
    border-right: 1px solid var(--rule);
    background: var(--bg-2);
  }

  .sidebar__inner {
    height: 100%;
    overflow-y: auto;
    padding: 16px 12px 40px;
  }

  .sidebar__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 12px;
    padding: 0 4px;
  }

  .sidebar__brand {
    display: flex;
    align-items: baseline;
    gap: 6px;
    text-decoration: none;
  }

  .sidebar__brand-mark {
    font-size: 15px;
    font-weight: 680;
    letter-spacing: -0.024em;
    color: var(--ink);
  }

  .sidebar__brand-sub {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .sidebar__nav {
    margin-top: 14px;
  }

  .sidebar__list {
    list-style: none;
    padding: 0;
  }

  .sidebar__group {
    margin-top: 14px;
  }

  .sidebar__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    padding: 4px 8px;
    cursor: pointer;
    list-style: none;
    border-radius: var(--radius-nav);
  }

  .sidebar__summary::-webkit-details-marker {
    display: none;
  }

  .sidebar__summary:hover {
    background: var(--bg-3);
  }

  .sidebar__chevron {
    color: var(--muted);
    transition: transform 120ms ease;
  }

  .sidebar__group[open] .sidebar__chevron {
    transform: rotate(90deg);
  }

  .sidebar__link {
    display: block;
    padding: 4px 8px;
    border-radius: var(--radius-nav);
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--ink-2);
    text-decoration: none;
    transition:
      background-color 120ms ease,
      color 120ms ease;
  }

  .sidebar__link:hover {
    background: var(--bg-3);
    color: var(--ink);
  }

  .sidebar__link.is-current {
    background: var(--mark-bg);
    color: var(--mark);
    font-weight: 560;
  }

  .sidebar__link--overview {
    color: var(--muted);
  }

  .sidebar__link--nested {
    margin-left: 12px;
    border-left: 1px solid var(--rule);
  }

  @media (max-width: 900px) {
    /* §8: the mobile sidebar drawer is one of the three places motion exists. */
    .sidebar {
      position: fixed;
      inset: 0 auto 0 0;
      z-index: 30;
      width: 264px;
      transform: translateX(-100%);
      transition: transform 160ms ease;
      box-shadow: var(--lift);
    }

    :global(body[data-drawer-open]) .sidebar {
      transform: translateX(0);
    }
  }
</style>
