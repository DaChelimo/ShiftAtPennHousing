# Copy to .env.local (gitignored) and fill in. `supabase start` prints the first three.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase start -> anon key>
SUPABASE_SERVICE_ROLE_KEY=<supabase start -> service_role key>

# Anthropic keys, one per feature (AGENTS.md: never reuse a key across features).
# Create each at https://console.anthropic.com — leave blank to disable that feature.
CLAUDE_AI_CREATE_SCHEDULE_KEY=<sk-ant-... for the AI schedule-builder agent>
CLAUDE_AI_CHATBOT_UPLOAD_CHUNKER=<sk-ant-... for KB document chunking on upload>
CLAUDE_AI_CHATBOT_PROPOSE=<sk-ant-... for KB metadata/redaction proposals>

# Voyage AI embeddings (Desk Assistant KB search). https://dash.voyageai.com
VOYAGE_API_KEY=<pa-...>
