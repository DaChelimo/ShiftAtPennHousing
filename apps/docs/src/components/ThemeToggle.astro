---
// §1 Dark mode is first class, follows the OS, with a toggle.
---

<button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch colour theme">
  <span class="theme-toggle__icon" data-icon="light" aria-hidden="true">
    <svg viewBox="0 0 16 16" width="13" height="13">
      <circle cx="8" cy="8" r="3.1" fill="currentColor"></circle>
      <g stroke="currentColor" stroke-width="1.3" stroke-linecap="round">
        <path d="M8 1v1.8M8 13.2V15M1 8h1.8M13.2 8H15M3.1 3.1l1.3 1.3M11.6 11.6l1.3 1.3M12.9 3.1l-1.3 1.3M4.4 11.6l-1.3 1.3"></path>
      </g>
    </svg>
  </span>
  <span class="theme-toggle__icon" data-icon="dark" aria-hidden="true">
    <svg viewBox="0 0 16 16" width="13" height="13">
      <path
        d="M13.4 9.6A5.8 5.8 0 0 1 6.4 2.6 5.8 5.8 0 1 0 13.4 9.6Z"
        fill="currentColor"></path>
    </svg>
  </span>
</button>

{/* The stored theme is applied in the document head, before paint, so a dark
    reader never sees a white flash. See BaseLayout.astro. */}

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const root = document.documentElement
      const isDark =
        root.dataset.theme === 'dark' ||
        (!root.dataset.theme && window.matchMedia('(prefers-color-scheme: dark)').matches)
      const next = isDark ? 'light' : 'dark'
      root.dataset.theme = next
      localStorage.setItem('shift-docs-theme', next)
    })
  })
</script>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--rule);
    border-radius: var(--radius-nav);
    background: var(--bg);
    color: var(--muted);
    cursor: pointer;
    transition:
      color 120ms ease,
      border-color 120ms ease;
  }

  .theme-toggle:hover {
    color: var(--ink-2);
    border-color: var(--mark-line);
  }

  .theme-toggle__icon {
    grid-area: 1 / 1;
  }

  /* Show the icon for the theme you would switch TO. */
  :global(:root[data-theme='dark']) .theme-toggle__icon[data-icon='dark'],
  .theme-toggle__icon[data-icon='light'] {
    display: none;
  }

  :global(:root[data-theme='dark']) .theme-toggle__icon[data-icon='light'] {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .theme-toggle__icon[data-icon='dark'] {
      display: none;
    }

    :global(:root:not([data-theme])) .theme-toggle__icon[data-icon='light'] {
      display: block;
    }
  }
</style>
