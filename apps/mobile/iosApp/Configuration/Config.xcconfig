// iOS app identity. Reference these from the Xcode target's build settings
// (PRODUCT_NAME = $(APP_NAME), PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_ID)).
APP_NAME = Shift PennHousing
BUNDLE_ID = com.pennhousing.shift
TEAM_ID =

// Supabase config surfaced into Info.plist (read by AppDelegate). Leave empty for
// the DemoData build; set per-environment (or via an untracked override xcconfig).
// NOTE: xcconfig treats `//` as the start of a comment, so a literal
// `http://…` truncates the value to `http:`. Compose the `//` from a variable
// so the scheme separator survives. (Android's local.properties has no such rule.)
SLASH = /
// Simulator: 127.0.0.1 reaches the host's local Supabase and never goes stale.
// Physical device: replace with the Mac's CURRENT LAN IP (e.g. http://192.168.x.y:54321)
// on a network where the phone can reach the Mac (a normal router LAN, not an iPhone
// Personal Hotspot, which isolates clients). Verify first from the Mac:
//   curl http://<mac-lan-ip>:54321/auth/v1/health   (must return 200)
// A hardcoded LAN IP goes stale on every DHCP/network change, which surfaced as a
// bogus "Incorrect email or password." until the login error handling was fixed.
SUPABASE_URL = http:$(SLASH)$(SLASH)127.0.0.1:54321
SUPABASE_ANON_KEY = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
