<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Supabase client + push-token POST (Ktor). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Notification channels: runtime permission required on Android 13+ (API 33). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ShiftApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.ShiftPennHousing">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ShiftPennHousing.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- T2-13: pennshift://float-ack/{floatId} opens the full-screen
                 FloatAckSurface (push-tap content intent + external deep links). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="pennshift"
                    android:host="float-ack" />
            </intent-filter>
        </activity>

        <!-- Upcoming-shifts home-screen widget (Glance). The system delivers the
             protected APPWIDGET_UPDATE broadcast to this receiver even though it is not
             exported. Mirrors the iOS ShiftWidgets extension. -->
        <receiver
            android:name=".widget.ShiftWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/shift_widget_info" />
        </receiver>

        <!-- FCM: receives new-token callbacks and push messages (deliverable #6). -->
        <service
            android:name=".push.AppFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/default_notification_channel_id" />
    </application>

</manifest>
