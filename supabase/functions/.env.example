# Copy to supabase/functions/.env (gitignored) and fill in.
# Read by Edge Functions when running `supabase functions serve`.

# Anthropic key, dedicated to the Desk Assistant chat feature (AGENTS.md: never
# reuse a key across features). Create at https://console.anthropic.com
CLAUDE_AI_CHATBOT_DESK_ASSISTANT=<sk-ant-...>

# Voyage AI embeddings (Desk Assistant KB search). https://dash.voyageai.com
VOYAGE_API_KEY=<pa-...>

FIREBASE_SERVICE_ACCOUNT_JSON='....'