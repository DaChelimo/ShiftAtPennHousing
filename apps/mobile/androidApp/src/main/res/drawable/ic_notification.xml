<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar small icon. Android masks setSmallIcon() to a solid colour (usually
  white) using only the drawable's ALPHA channel — RGB is discarded. ic_launcher is
  opaque everywhere (it bakes in the #F4F3F0 background layer), so using it there
  renders as a solid coloured square, not a recognisable glyph. This reuses the
  brand mark's monochrome geometry (see ic_launcher_monochrome.xml) — opaque glyph,
  transparent elsewhere — which is exactly the shape a status-bar icon needs.
-->
