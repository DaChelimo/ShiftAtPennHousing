---
/*
 * §1 The landing page gets a separate treatment: marketing weight,
 * institutional voice. It is the only page with the hero scale (§3) and the
 * only place the 999px badge radius is used (§4).
 * Content per SKETCH.md §7.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import ThemeToggle from '../components/ThemeToggle.astro'
import { withBase } from '../href'
import { sections } from '../nav'

const routes = [
  {
    href: '/workers',
    eyebrow: "I'm a student worker",
    title: 'Work the desk',
    body: 'Pick up shifts, drop what you cannot work, swap with a colleague, and answer a float. Five verbs, thirteen short pages.',
  },
  {
    href: '/managers',
    eyebrow: "I'm a manager",
    title: 'Build and respond',
    body: 'Turn preferences into a staffed week, publish it, and handle a desk that is about to be empty without guessing who to call.',
  },
  {
    href: '/system',
    eyebrow: 'I want to understand it',
    title: 'How it decides',
    body: 'The coverage ladder, the float selection rule, hours attribution, and the roles that constrain all three.',
  },
]

const capabilities = [
  ['Builds from preferences', 'Workers paint their week; the builder fills seats against it, with or without AI assistance.'],
  ['Covers gaps automatically', 'An unclaimed block is broadcast, then floated, then escalated to a person. No one has to be watching.'],
  ['Moves staff between houses', 'A desk that would be empty is covered from a house with staff to spare, without emptying that house.'],
  ['Tracks hours as they move', 'Weekly totals, soft and hard caps, and hours worked at another house, counted once.'],
]
---

<BaseLayout
  title="Shift"
  description="The user guide for Shift, the staffing and coverage system for Penn Residential Housing front desks."
>
  <header class="topline">
    <a class="topline__brand" href={withBase('/')}>
      <span class="topline__mark">Shift</span>
      <span class="topline__sub">User guide</span>
    </a>
    <nav class="topline__nav" aria-label="Sections">
      {sections.map((section) => <a href={withBase(`/${section.slug}`)}>{section.label}</a>)}
      <ThemeToggle />
    </nav>
  </header>

  <main id="content">
    <section class="hero">
      <p class="badge">Penn Residential Housing</p>
      <h1 class="hero__title">Every desk covered, and a record of how.</h1>
      <p class="hero__lede">
        Shift schedules and staffs the front desks of thirteen college houses. It replaces the
        weekly coverage scramble: the group chat at 9pm, the manager calling down a list, and
        the desk that turns out to have been empty since ten.
      </p>
      <p class="hero__lede">
        Workers see and change their own week from their phone. Managers build a term of
        schedules from stated availability, and get paged only when the system has genuinely
        run out of options. When a desk would be empty, it looks for someone already on shift
        nearby before anyone pays for a guard.
      </p>
      <div class="hero__actions">
        <a class="button button--primary" href={withBase('/getting-started')}>Getting started</a>
        <a class="button" href={withBase('/system/floating')}>How floating works</a>
      </div>
    </section>

    <section class="routes" aria-label="Choose your path">
      {
        routes.map((route) => (
          <a class="route" href={withBase(route.href)}>
            <span class="eyebrow">{route.eyebrow}</span>
            <span class="route__title">{route.title}</span>
            <span class="route__body">{route.body}</span>
            <span class="route__go" aria-hidden="true">
              Read the section
            </span>
          </a>
        ))
      }
    </section>

    <section class="strip" aria-label="What it does">
      <h2 class="strip__title">What it does</h2>
      <div class="strip__grid">
        {
          capabilities.map(([title, body]) => (
            <div class="strip__item">
              <span class="strip__item-title">{title}</span>
              <span class="strip__item-body">{body}</span>
            </div>
          ))
        }
      </div>
    </section>

    <footer class="foot">
      <p>
        This site describes what Shift does. It is not a policy document, and it is not the
        engineering specification.
      </p>
    </footer>
  </main>
</BaseLayout>

<style>
  .topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 34px;
    border-bottom: 1px solid var(--rule);
  }

  .topline__brand {
    display: flex;
    align-items: baseline;
    gap: 7px;
    text-decoration: none;
  }

  .topline__mark {
    font-size: 16px;
    font-weight: 680;
    letter-spacing: -0.024em;
    color: var(--ink);
  }

  .topline__sub {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .topline__nav {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .topline__nav a {
    font-size: 12.5px;
    color: var(--ink-2);
    text-decoration: none;
    transition: color 120ms ease;
  }

  .topline__nav a:hover {
    color: var(--mark);
  }

  main {
    max-width: 940px;
    margin: 0 auto;
    padding: 0 34px 64px;
  }

  .hero {
    padding: 64px 0 40px;
    max-width: 660px;
  }

  .badge {
    display: inline-block;
    padding: 3px 11px;
    border: 1px solid var(--mark-line);
    border-radius: 999px;
    background: var(--mark-bg);
    color: var(--mark);
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .hero__title {
    margin-top: 18px;
    font-size: clamp(32px, 4.8vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.035em;
    font-weight: 690;
  }

  .hero__lede {
    margin-top: 16px;
    font-size: 14.5px;
    line-height: 1.62;
    color: var(--ink-2);
    max-width: 62ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 26px;
  }

  .button {
    display: inline-block;
    padding: 8px 15px;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    font-size: 13.5px;
    font-weight: 560;
    color: var(--ink);
    text-decoration: none;
    transition:
      border-color 120ms ease,
      background-color 120ms ease;
  }

  .button:hover {
    border-color: var(--mark-line);
    background: var(--bg-2);
  }

  .button--primary {
    background: var(--mark);
    border-color: var(--mark);
    color: #fff;
  }

  .button--primary:hover {
    background: var(--mark);
    border-color: var(--mark);
    filter: brightness(1.08);
  }

  .routes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 9px;
    padding-top: 24px;
    border-top: 1px solid var(--rule-2);
  }

  .route {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    text-decoration: none;
    transition:
      border-color 120ms ease,
      background-color 120ms ease;
  }

  .route:hover {
    border-color: var(--mark-line);
    background: var(--bg-2);
  }

  .route__title {
    font-size: 17.5px;
    font-weight: 640;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .route__body {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .route__go {
    margin-top: auto;
    padding-top: 10px;
    font-size: 12.5px;
    font-weight: 560;
    color: var(--mark);
  }

  .strip {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--rule-2);
  }

  .strip__title {
    font-size: 17.5px;
  }

  .strip__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 9px;
    margin-top: 16px;
  }

  .strip__item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--bg-2);
  }

  .strip__item-title {
    font-size: 13.5px;
    font-weight: 620;
    color: var(--ink);
  }

  .strip__item-body {
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .foot {
    margin-top: 40px;
    padding-top: 18px;
    border-top: 1px solid var(--rule-2);
    font-size: 12.5px;
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .topline {
      padding: 12px 20px;
    }

    .topline__nav a:not(:last-of-type) {
      display: none;
    }

    main {
      padding: 0 20px 48px;
    }

    .hero {
      padding: 40px 0 28px;
    }

    .routes,
    .strip__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
