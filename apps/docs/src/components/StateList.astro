---
// §5 State list: the container for StateCard, used anywhere the app's states
// are explained. Two up on desktop, one up on mobile.
---

<div class="state-list"><slot /></div>

<style>
  .state-list {
    display: grid;
    gap: 8px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (max-width: 700px) {
    .state-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
