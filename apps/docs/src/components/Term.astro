---
/*
 * §5 Glossary link: dashed underline, native title.
 * SKETCH.md §3: linked on first use per page, not every use.
 */
type Props = { of: string; define: string }
const { of: anchor, define } = Astro.props
---

<a class="term" href={`/system/glossary#${anchor}`} title={define}><slot /></a>

<style>
  .term {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px dashed var(--muted);
    cursor: help;
  }

  .term:hover {
    color: var(--mark);
    border-bottom-color: var(--mark);
  }
</style>
