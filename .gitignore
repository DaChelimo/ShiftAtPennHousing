# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
.next/
.turbo/
out/

# Environment files
.env
.env.local
.env.*.local

# Supabase
.supabase/

# Android
apps/mobile/.gradle/
apps/mobile/build/
apps/mobile/composeApp/build/
apps/mobile/local.properties

# iOS
# Machine-local build config (Supabase URL/key + the demo-vs-live flag).
# Every .xcconfig here is machine-local except the checked-in *.example templates.
apps/mobile/iosApp/Configuration/*.xcconfig
!apps/mobile/iosApp/Configuration/*.xcconfig.example
apps/mobile/iosApp/.build/
apps/mobile/iosApp/iosApp.xcworkspace/xcuserdata/
*.xcuserstate

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
*.iml
.vscode/settings.json

# Claude Code — local settings contain secrets (service role key)
.claude/settings.local.json

# Emitted JS from TS sources (build output belongs in dist/)
packages/core/src/**/*.js
packages/core/src/**/*.d.ts

# edge-runtime watchdog log (local dev)
scripts/edge-watchdog.log

# Local DB backups (pre-upgrade dumps). Never committed.
.local-backups/

# QA mode marker: derived state, never committed. Owned by scripts/qa/qa-mode.sh
.qa-mode
.vercel
