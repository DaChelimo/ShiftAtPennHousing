---
// §5 Card grid. Used on section overview pages, which are real pages (SKETCH.md §9.2).
type Props = { columns?: 2 | 3 }
const { columns = 2 } = Astro.props
---

<div class="card-grid" data-columns={columns}>
  <slot />
</div>

<style>
  .card-grid {
    display: grid;
    gap: 9px;
    grid-template-columns: repeat(var(--cols, 2), minmax(0, 1fr));
  }

  .card-grid[data-columns='3'] {
    --cols: 3;
  }

  @media (max-width: 700px) {
    .card-grid {
      --cols: 1 !important;
    }
  }
</style>
