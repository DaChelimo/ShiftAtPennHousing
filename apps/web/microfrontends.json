{
  "$schema": "https://openapi.vercel.sh/microfrontends.json",
  "version": "1",
  "applications": {
    "shift-web": {
      "packageName": "@shift/web",
      "development": {
        "fallback": "REPLACE-WITH-REAL-PRODUCTION-HOST.invalid",
        "local": 3000
      }
    },
    "shift-docs": {
      "packageName": "@shift/docs",
      "routing": [
        {
          "group": "user-guide",
          "paths": ["/guide", "/guide/:path*"]
        }
      ],
      "development": {
        "local": 4321,
        "task": "dev"
      }
    }
  }
}
