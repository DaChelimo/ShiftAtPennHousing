{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@shift/web", "dev"],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@shift/web", "exec", "next", "dev", "-p", "3100"],
      "port": 3100
    },
    {
      "name": "docs",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@shift/docs", "dev", "--port", "4321"],
      "port": 4321
    },
    {
      "name": "docs-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@shift/docs", "preview", "--port", "4322"],
      "port": 4322
    }
  ]
}
